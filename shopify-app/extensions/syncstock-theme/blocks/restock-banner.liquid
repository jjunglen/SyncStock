{%- comment -%}
  "Restock alerts" — a section merchants add in the theme editor. Left:
  the SyncStock logo and name, what it does, and the button with "Only
  takes 30 seconds". Right: a phone showing what the alert looks like,
  with the store's name and (optionally) one of its products.
  The button goes to api.syncstock.io/api/store/go, which finds this
  store's SyncStock site from the Shopify domain (no setup needed) and
  tags the visit so signups from it show on the merchant dashboard.
  Uses the theme's fonts, text color and button colors (syncstock.css).
{%- endcomment -%}
{%- liquid
  assign syncstock_url = 'https://api.syncstock.io/api/store/go?src=banner&shop=' | append: shop.permanent_domain
  if block.settings.logo_style == 'light'
    assign logo_file = 'syncstock-mark-light.png'
  else
    assign logo_file = 'syncstock-mark-dark.png'
  endif
  assign item = block.settings.preview_product
  if item != blank
    assign item_price = item.price | money_without_trailing_zeros
    assign item_line = item.title | append: ' · ' | append: item_price
  else
    assign item_line = block.settings.preview_example
  endif
-%}
<div class="syncstock-alerts" {{ block.shopify_attributes }}>
  <div class="syncstock-alerts__inner{% unless block.settings.show_preview %} syncstock-alerts__inner--solo{% endunless %}">
    <div class="syncstock-alerts__copy">
      <div class="syncstock-alerts__brand">
        <img
          src="{{ logo_file | asset_url }}"
          alt=""
          width="34"
          height="32"
          loading="lazy"
        >
        <span>SyncStock</span>
      </div>
      {%- if block.settings.heading != blank -%}
        <h2 class="syncstock-alerts__heading h2">{{ block.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <p class="syncstock-alerts__text">{{ block.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if block.settings.show_preview -%}
      <div class="syncstock-alerts__phone" aria-hidden="true">
        <div class="syncstock-alerts__time">9:41</div>
        <div class="syncstock-alerts__notif">
          <span class="syncstock-alerts__icon">
            <img src="{{ 'syncstock-mark-dark.png' | asset_url }}" alt="" width="24" height="23" loading="lazy">
          </span>
          <span class="syncstock-alerts__notif-body">
            <small>{{ shop.name | escape }} · now</small>
            <strong>Back in your size</strong>
            {%- if item_line != blank -%}<span>{{ item_line | escape }}</span>{%- endif -%}
          </span>
        </div>
        <div class="syncstock-alerts__notif syncstock-alerts__notif--older">
          <span class="syncstock-alerts__icon">
            <img src="{{ 'syncstock-mark-dark.png' | asset_url }}" alt="" width="24" height="23" loading="lazy">
          </span>
          <span class="syncstock-alerts__notif-body">
            <small>{{ shop.name | escape }} · 2h ago</small>
            <strong>Price drop</strong>
            <span>An item you saved just got cheaper</span>
          </span>
        </div>
      </div>
    {%- endif -%}

    <div class="syncstock-alerts__cta">
      <a
        class="syncstock-alerts__button"
        href="{{ syncstock_url }}"
        {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{- block.settings.button_label | default: 'Get restock alerts' | escape -}}
      </a>
      {%- if block.settings.note != blank -%}
        <span class="syncstock-alerts__note"><span class="syncstock-alerts__dot"></span>{{ block.settings.note | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Restock alerts",
  "target": "section",
  "stylesheet": "syncstock.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your size, the moment it's back" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sold out? Save your size and the pairs you want. We'll tell you the second they restock, before anyone else."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get restock alerts" },
    { "type": "text", "id": "note", "label": "Small print", "default": "Only takes 30 seconds" },
    {
      "type": "select",
      "id": "logo_style",
      "label": "SyncStock logo",
      "info": "Use White on dark backgrounds.",
      "options": [
        { "value": "dark", "label": "Black" },
        { "value": "light", "label": "White" }
      ],
      "default": "dark"
    },
    { "type": "header", "content": "Alert preview" },
    { "type": "checkbox", "id": "show_preview", "label": "Show the phone alert preview", "default": true },
    {
      "type": "product",
      "id": "preview_product",
      "label": "Product in the preview",
      "info": "Its name and price appear in the example alert. Leave empty to use the text below."
    },
    {
      "type": "text",
      "id": "preview_example",
      "label": "Example item",
      "default": "Jordan 4 Retro · Size 10"
    },
    { "type": "header", "content": "Link" },
    { "type": "checkbox", "id": "new_tab", "label": "Open in a new tab", "default": false }
  ]
}
{% endschema %}
