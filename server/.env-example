# App
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Supabase/Postgres)
DATABASE_URL=

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# NOTE: Shopify credentials (shop domain, Admin API access token,
# webhook secret) are NOT set here — they're per-store, entered
# during onboarding, and stored (encrypted) on the stores table.
# See src/models/Store.js