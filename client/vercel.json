{
  "rewrites": [
    { "source": "/robots.txt", "has": [{ "type": "host", "value": "www.syncstock.io" }], "destination": "/robots-main.txt" },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(?<store>[a-z0-9-]+)\\.syncstock\\.io" }],
      "destination": "https://api.syncstock.io/api/seo/robots.txt?store=:store"
    },
    { "source": "/robots.txt", "destination": "/robots-main.txt" },
    {
      "source": "/sitemap-products.xml",
      "has": [{ "type": "host", "value": "(?<store>[a-z0-9-]+)\\.syncstock\\.io" }],
      "destination": "https://api.syncstock.io/api/seo/sitemap.xml?store=:store"
    },
    { "source": "/shopify", "destination": "/shopify.html" },
    { "source": "/shopify/(.*)", "destination": "/shopify.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/shopify(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://*.myshopify.com https://admin.shopify.com" }
      ]
    }
  ]
}
